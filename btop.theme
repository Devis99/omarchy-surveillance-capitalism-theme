# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#131e28"

# Main text color
theme[main_fg]="#c8d3da"

# Title color for boxes
theme[title]="#c8d3da"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ccdae3"

# Background color of selected item in processes box
theme[selected_bg]="#2b3d4c"

# Foreground color of selected item in processes box
theme[selected_fg]="#ccdae3"

# Color of inactive/disabled text
theme[inactive_fg]="#626d78"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#e5ecf1"

# Background color of the percentage meters
theme[meter_bg]="#2b3d4c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#e5ecf1"

# Like cava: graphs rise from steel to ice white; red appears only where load or heat peaks.
theme[cpu_box]="#626d78"
theme[mem_box]="#626d78"
theme[net_box]="#626d78"
theme[proc_box]="#ccdae3"

# Box divider line and small boxes line color
theme[div_line]="#626d78"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#95a0a9"
theme[temp_mid]="#e5ecf1"
theme[temp_end]="#e24945"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#626d78"
theme[cpu_mid]="#c8d3da"
theme[cpu_end]="#e24945"

# Mem/Disk free meter
theme[free_start]="#2b3d4c"
theme[free_mid]="#95a0a9"
theme[free_end]="#e5ecf1"

# Mem/Disk cached meter
theme[cached_start]="#2b3d4c"
theme[cached_mid]="#95a0a9"
theme[cached_end]="#e5ecf1"

# Mem/Disk available meter
theme[available_start]="#2b3d4c"
theme[available_mid]="#95a0a9"
theme[available_end]="#e5ecf1"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#626d78"
theme[used_mid]="#c8d3da"
theme[used_end]="#e24945"

# Download graph colors
theme[download_start]="#2b3d4c"
theme[download_mid]="#95a0a9"
theme[download_end]="#e5ecf1"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#2b3d4c"
theme[upload_mid]="#95a0a9"
theme[upload_end]="#e5ecf1"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#626d78"
theme[process_mid]="#c8d3da"
theme[process_end]="#e24945"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#131e28"
theme[gradient_color_1]="#1e2a35"
theme[gradient_color_2]="#2b3d4c"
theme[gradient_color_3]="#626d78"
theme[gradient_color_4]="#95a0a9"
theme[gradient_color_5]="#c8d3da"
theme[gradient_color_6]="#e5ecf1"
theme[gradient_color_7]="#eaeff3"
